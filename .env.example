# ============================================================
# EDUCAR — Variables de entorno de ejemplo
# Copiar como .env.local para desarrollo local
# NUNCA commitear .env o .env.local con credenciales reales
# ============================================================

# Entorno (development | staging | production)
NODE_ENV=development

# API (apps/api — Cloudflare Worker)
# En desarrollo, Wrangler usa .dev.vars (no este archivo)
# ENVIRONMENT=development

# ============================================================
# Servicios futuros (no implementados en Etapa 01)
# ============================================================
# BASE DE DATOS REMOTA: implementar en Etapa DB con RLS y aislamiento de tenant
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
#
# AUTENTICACIÓN: implementar en Etapa Auth con MFA y privacidad de menores
# AUTH_SECRET=
#
# ALMACENAMIENTO R2: implementar en Etapa Contenido con acceso privado
# R2_BUCKET_NAME=
#
# SERVICIOS DE IA: implementar solo en etapas pedagógicas aprobadas
# AI_API_KEY=
# ============================================================
