{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@educar/shared": ["../../packages/shared/src/index.ts"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "e2e"],
  "exclude": ["node_modules", "dist"]
}
